# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
#
# /ios and /android are generated by `expo prebuild`, which `expo run:ios` and
# `expo run:android` invoke for you. This project has no native code of its own
# to keep: app.json and the config plugins it lists are the source of truth,
# and the generated projects are rebuilt from them. Checking them in would mean
# maintaining two descriptions of the same thing.
/ios
/android
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
credentials/
*.apk
*.tar.gz
*.aab

# Database copies pulled off a device or simulator hold someone's health data.
*.db
*.db-journal
*.db-wal
*.db-shm

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDEs
.idea/

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Claude Code. `.claude/settings.json`, `.claude/hooks/` and `.claude/skills/`
# are tracked and shared; personal overrides and agent worktrees are not.
.claude/settings.local.json
.claude/worktrees/

app-example

docs/.vercel