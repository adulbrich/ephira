    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "4.5.1",
