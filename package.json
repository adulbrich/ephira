    "devalue": "^5.6.2",
    "drizzle-orm": "^0.45.1",
    "expo": "~57.0.14",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.12",
