    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.7",
    "baseline-browser-mapping": "^2.9.19",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.8",
