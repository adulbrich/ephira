{
  "name": "ephira",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "biome check . && eslint . --max-warnings=0",
    "format": "biome check --write .",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)"
