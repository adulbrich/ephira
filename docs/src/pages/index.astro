---
// PROTOTYPE, on the throwaway branch prototype/landing-redesign: three landing
// page redesigns on the real route, switchable with ?variant=A|B|C. A static
// page cannot read the query at build time, so all three render and the inline
// script unhides one. Lazy images inside the hidden ones are never fetched.
// The floating switcher exists only under `astro dev`; the query works anywhere.
import "../styles/global.css";
import PrototypeSwitcher from "../components/prototype/PrototypeSwitcher.astro";
import VariantA from "../components/prototype/VariantA.astro";
import VariantB from "../components/prototype/VariantB.astro";
import VariantC from "../components/prototype/VariantC.astro";

const variants = [
  { key: "A", name: "Editorial" },
  { key: "B", name: "Bento" },
  { key: "C", name: "Listing" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Private Period Tracking | ephira</title>
    <meta
      name="description"
      content="An encrypted, open-source period tracker for iOS and Android. No account, no cloud, no ads."
    />
  </head>
  <body class="min-h-screen bg-plum-950">
    <div data-variant="A" hidden><VariantA /></div>
    <div data-variant="B" hidden><VariantB /></div>
    <div data-variant="C" hidden><VariantC /></div>

    <script is:inline>
      (() => {
        const panes = [...document.querySelectorAll("[data-variant]")];
        const keys = panes.map((pane) => pane.dataset.variant);
        window.protoShow = (key) => {
          for (const pane of panes) pane.hidden = pane.dataset.variant !== key;
          document.documentElement.dataset.variant = key;
          const url = new URL(location.href);
          url.searchParams.set("variant", key);
          history.replaceState(null, "", url);
        };
        const asked = new URLSearchParams(location.search).get("variant")?.toUpperCase();
        window.protoShow(keys.includes(asked) ? asked : keys[0]);
      })();
    </script>

    {import.meta.env.DEV && <PrototypeSwitcher variants={variants} />}
  </body>
</html>

<style is:global>
  .proto-hide-labels .proto-label {
    display: none;
  }
</style>
