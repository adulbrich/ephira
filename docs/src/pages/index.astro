---
import Question from "../components/Question.astro";
import Shot from "../components/Shot.astro";
import Download from "../components/Download.astro";
import Layout from "../layouts/Layout.astro";

import calendar from "../assets/screens/calendar.webp";
import customEntry from "../assets/screens/custom-entry.webp";
import cycle from "../assets/screens/cycle.webp";
import exportData from "../assets/screens/export.webp";
import filter from "../assets/screens/filter.webp";
import home from "../assets/screens/home.webp";
import lock from "../assets/screens/lock.webp";
import log from "../assets/screens/log.webp";
import theme from "../assets/screens/theme.webp";

const receipt = [
  ["Account", "none"],
  ["Cloud sync", "none"],
  ["Usage data", "none"],
  ["Ads", "none"],
  ["Encryption key", "locked to phone"],
];

// What Export Data writes, named in the tour and in the FAQ.
const exported = "flow, symptoms, moods, medications, birth control and notes";

const tour = [
  {
    title: "Today at a glance",
    body: "Where you are in your cycle and your latest period, on one screen.",
    src: home,
    alt: "The home screen: the current cycle phase, a ring of this month's flow days with today marked, and the five most recent flow days",
  },
  {
    title: "Your month, marked",
    body: "Flow and the symptom you choose, under each day.",
    src: calendar,
    alt: "The October calendar with flow marked on the 3rd to the 7th and headaches on the 14th and 16th",
  },
  {
    title: "Log in a tap",
    body: "Flow, symptoms, moods, medications, birth control, intercourse and notes.",
    src: log,
    alt: "Logging a day: symptom chips with Headache and Vertigo selected",
  },
  {
    title: "Know your cycle",
    body: "Your phase, the day of your cycle, and when your next period should start.",
    src: cycle,
    alt: "The Cycle tab: ovulation phase, day 17 of 29, and the next period predicted in 13 days with high confidence",
  },
  {
    title: "Add your own entries",
    body: "Track a symptom, mood or medication the app did not think of.",
    src: customEntry,
    alt: "Custom Entries with two custom symptoms, Vertigo and Migraine aura",
  },
  {
    title: "Choose what you see",
    body: "Filter the calendar down to what matters to you.",
    src: filter,
    alt: "The Filter Calendar dialog with Flow, Headache and Cycle Prediction turned on",
  },
  {
    title: "Lock it",
    body: "Your phone's own unlock, passcode included, or a password just for ephira.",
    src: lock,
    alt: "The lock screen in dark mode, asking for the ephira password",
  },
  {
    title: "Make it yours",
    body: "Six colour themes, light or dark to match your phone.",
    src: theme,
    alt: "The home screen in the pink theme",
  },
  {
    title: "Take it with you",
    body: `Your ${exported}, as CSV, PDF or JSON.`,
    src: exportData,
    alt: "Exporting data as a PDF, with the share sheet open on a 6 KB file",
  },
];

const faq = [
  {
    question: "Where is my data stored?",
    answer: "On your phone, in a database encrypted with SQLCipher. Its key is locked to that phone, so a backup restores your data only to the phone it came from. A backup made before ephira began encrypting can still hold a readable copy.",
  },
  {
    question: "Do I need an account?",
    answer: "No. Install it and start logging. The optional lock uses your phone's own unlock, passcode included, or a password you set in the app.",
  },
  {
    question: "What happens when I change phones?",
    answer: `Your data does not move to a new phone, and the app cannot import an export. Export first to keep a copy of your ${exported}.`,
  },
  {
    question: "When do predictions start?",
    answer: "Once you have logged two periods of three or more consecutive flow days, turn on Cycle Predictions in Settings.",
  },
  {
    question: "How do I delete my data?",
    answer: "In Settings, open Data and choose Delete Data. Uninstalling the app deletes its data too.",
  },
];
---

<Layout
  title="Private Period Tracking"
  description="An encrypted, open-source period tracker for iOS. No account, no cloud, no ads."
>
  <section
    class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-14 md:grid-cols-[1.2fr_1fr] md:px-8 md:py-24"
  >
    <div>
      <p class="text-sm font-medium text-cream/80">Period tracker for iOS</p>
      <h1
        class="mt-3 font-serif text-4xl leading-tight font-bold text-balance text-white md:text-6xl"
      >
        The period tracker with nothing to sync.
      </h1>
      <p class="mt-5 max-w-lg text-lg text-white/70">
        What you log is encrypted with a key locked to your phone. There is no account to
        make and no server to trust.
      </p>
      <Download id="download" class="mt-8" />
    </div>
    <aside
      aria-labelledby="receipt"
      class="mx-auto w-full max-w-sm rotate-1 rounded-xl bg-paper p-6 font-mono text-sm text-ink shadow-2xl shadow-black/50"
    >
      <h2 id="receipt" class="text-center text-xs font-semibold tracking-widest uppercase">
        What leaves your phone
      </h2>
      <dl class="mt-4 divide-y divide-dashed divide-ink/25 border-y border-dashed border-ink/25">
        {
          receipt.map(([item, value]) => (
            <div class="flex justify-between gap-4 py-2.5">
              <dt>{item}</dt>
              <dd class="text-right">{value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 flex justify-between font-semibold">
        <span>Sent to us</span><span>nothing</span>
      </p>
    </aside>
  </section>

  <section class="border-y border-white/10 bg-plum-900 py-14" aria-labelledby="tour">
    <div class="mx-auto flex max-w-6xl items-end justify-between px-5 md:px-8">
      <h2 id="tour" class="font-serif text-3xl font-bold text-cream md:text-4xl">A look inside</h2>
      <p class="text-sm text-white/50">Scroll sideways</p>
    </div>
    <ol
      tabindex="0"
      aria-label="Screenshots of ephira"
      class="mt-8 flex snap-x snap-mandatory scroll-px-5 gap-5 overflow-x-auto px-5 pt-3 pb-6 focus-visible:outline-2 focus-visible:outline-cream md:[--gutter:max(2rem,calc((100%_-_72rem)/2_+_2rem))] md:scroll-px-(--gutter) md:px-(--gutter)"
    >
      {
        /* sizes names the li's widths: w-52 is 208px, md:w-60 is 240px. */
        tour.map((item, i) => (
          <li class="w-52 shrink-0 snap-start md:w-60">
            <Shot
              src={item.src}
              alt={item.alt}
              sizes="(min-width: 768px) 240px, 208px"
              eager={i < 2}
            />
            <h3 class="mt-5 font-semibold text-white">{item.title}</h3>
            <p class="mt-1 text-sm text-white/65">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-20 md:px-8" aria-labelledby="faq">
    <h2 id="faq" class="font-serif text-3xl font-bold text-cream md:text-4xl">Questions</h2>
    <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
      {
        faq.map(({ question, answer }) => (
          <Question question={question}>{answer}</Question>
        ))
      }
      <Question question="Can I check any of this?">
        Yes. ephira is MIT licensed and the whole source is on
        <a class="text-cream underline" href="https://github.com/adulbrich/ephira">GitHub</a>.
      </Question>
    </div>
  </section>
</Layout>
