---
// Both badges are served from this site. Apple's badge used to be hotlinked,
// which sent every visitor's address to two Apple hosts before they had
// clicked anything; the SVG is Apple's own, downloaded unchanged.
import { Picture } from "astro:assets";
import appStore from "../assets/app-store-badge.svg";
import googlePlay from "../assets/google-play-badge.png";

interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<div id={id} class:list={["flex flex-wrap items-center gap-3", className]}>
  <a href="https://apps.apple.com/us/app/ephira/id6741593838?platform=iphone">
    <img
      src={appStore.src}
      alt="Download on the App Store"
      width={appStore.width}
      height={appStore.height}
      class="h-12 w-auto"
    />
  </a>
  <a href="https://play.google.com/store/apps/details?id=com.capucity.ephira">
    <Picture
      src={googlePlay}
      widths={[162, 270]}
      sizes="162px"
      formats={["avif", "webp"]}
      alt="Get it on Google Play"
      class="h-12 w-auto"
    />
  </a>
</div>
