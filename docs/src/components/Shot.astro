---
// One app screenshot in a CSS phone frame. `widths` with `sizes` lets the
// browser pick a 360 or 720 px derivative instead of the 959 px source. The
// fallback is WebP because Astro's default, PNG, is about ten times the size.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { src, alt, sizes, eager = false } = Astro.props;
---

<div
  class="rounded-[2.1rem] bg-black p-1.5 shadow-2xl shadow-black/40 ring-1 ring-white/10"
>
  <Picture
    src={src}
    alt={alt}
    widths={[360, 720]}
    sizes={sizes}
    formats={["avif"]}
    fallbackFormat="webp"
    loading={eager ? "eager" : "lazy"}
    class="block h-auto w-full rounded-[1.75rem]"
  />
</div>
