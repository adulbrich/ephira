---
// PROTOTYPE variant C, "Listing": an app store page you own. A split hero with
// a receipt of what leaves the phone instead of a phone, a sideways-scrolling
// tour of captioned screens, then questions in <details> and a download block.
import ProtoFooter from "./ProtoFooter.astro";
import Shot from "./Shot.astro";
import StoreBadges from "./StoreBadges.astro";
import Wordmark from "./Wordmark.astro";
import { shots, themes } from "./screens";

const receipt = [
  ["Account", "none"],
  ["Cloud copy", "none"],
  ["Usage data", "none"],
  ["Ads", "none"],
  ["Encryption key", "stays on phone"],
];

const tour = [
  {
    title: "Your month at a glance",
    body: "Flow and symptoms marked under each day.",
    shot: shots.calMonth,
  },
  {
    title: "Log in a tap",
    body: "Flow, symptoms, moods, medications, birth control, notes.",
    shot: shots.logChips,
  },
  {
    title: "Add your own entries",
    body: "Track a symptom the app did not think of.",
    shot: shots.customEntry,
  },
  {
    title: "Filter the legend",
    body: "Show only what you want to see.",
    shot: shots.filterDialog,
  },
  {
    title: "Lock it",
    body: "Face ID, fingerprint, or an ephira password.",
    shot: shots.lock,
  },
  {
    title: "Make it yours",
    body: "Six colour themes, light and dark.",
    shot: themes[7],
  },
  {
    title: "Know your cycle",
    body: "Phase, predictions and averages after two cycles.",
    missing: "Cycle tab",
  },
  {
    title: "Take it with you",
    body: "Export your full history as a PDF.",
    missing: "Export flow",
  },
];

const faq = [
  {
    q: "Where is my data stored?",
    a: "On your phone only, in a database encrypted with SQLCipher (AES-256). The key never leaves your phone.",
  },
  {
    q: "Do I need an account?",
    a: "No. Install it and start logging. The optional lock uses Face ID, fingerprint, or a password you set in the app.",
  },
  {
    q: "What happens when I change phones?",
    a: "Your data does not move to a new phone. Export it as a PDF first if you want to keep a copy.",
  },
  {
    q: "When do predictions start?",
    a: "After two complete cycles, from your own logged history. You can turn them off in Settings.",
  },
  {
    q: "How do I delete everything?",
    a: "Settings, Delete Data, type “delete data” and confirm. Uninstalling the app deletes it too.",
  },
  {
    q: "Can I check any of this?",
    a: "Yes. ephira is MIT licensed and the whole source is on GitHub.",
  },
];
---

<div class="min-h-screen bg-plum-950 text-white/90">
  <header class="sticky top-0 z-20 border-b border-white/10 bg-plum-950/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 md:px-8">
      <Wordmark class="text-white" />
      <a
        href="#c-download"
        class="rounded-full bg-cream px-4 py-2 text-sm font-semibold text-plum-950 hover:bg-white"
        >Download</a
      >
    </div>
  </header>

  <main>
    <section
      class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-14 md:grid-cols-[1.2fr_1fr] md:px-8 md:py-24"
    >
      <div>
        <p class="text-sm font-medium text-cream/80">Period tracker for iOS and Android</p>
        <h1
          class="mt-3 font-serif text-4xl leading-tight font-bold text-balance text-white md:text-6xl"
        >
          The period tracker with nothing to sync.
        </h1>
        <p class="mt-5 max-w-lg text-lg text-white/70">
          Everything you log is encrypted and stays on your phone. There is no account to make
          and no server to trust.
        </p>
        <StoreBadges class="mt-8" />
      </div>
      <aside
        aria-labelledby="c-receipt"
        class="mx-auto w-full max-w-sm rotate-1 rounded-xl bg-paper p-6 font-mono text-sm text-ink shadow-2xl shadow-black/50"
      >
        <h2 id="c-receipt" class="text-center text-xs font-semibold tracking-widest uppercase">
          What leaves your phone
        </h2>
        <dl class="mt-4 divide-y divide-dashed divide-ink/25 border-y border-dashed border-ink/25">
          {
            receipt.map(([item, value]) => (
              <div class="flex justify-between gap-4 py-2.5">
                <dt>{item}</dt>
                <dd class="text-right">{value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-3 flex justify-between font-semibold">
          <span>Sent to us</span><span>nothing</span>
        </p>
      </aside>
    </section>

    <section class="border-y border-white/10 bg-plum-900 py-14" aria-labelledby="c-tour">
      <div class="mx-auto flex max-w-6xl items-end justify-between px-5 md:px-8">
        <h2 id="c-tour" class="font-serif text-3xl font-bold text-cream md:text-4xl">
          A look inside
        </h2>
        <p class="text-sm text-white/50">Scroll sideways</p>
      </div>
      <ol
        class="mt-8 flex snap-x snap-mandatory scroll-px-5 gap-5 overflow-x-auto px-5 pt-3 pb-6 md:scroll-px-8 md:px-[max(2rem,calc((100%_-_72rem)/2_+_2rem))]"
      >
        {
          tour.map((t) => (
            <li class="w-52 shrink-0 snap-start md:w-60">
              <Shot
                shot={t.shot}
                missing={t.missing}
                frame
                sizes="(min-width: 768px) 240px, 208px"
              />
              <h3 class="mt-5 font-semibold text-white">{t.title}</h3>
              <p class="mt-1 text-sm text-white/65">{t.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mx-auto max-w-3xl px-5 py-20 md:px-8" aria-labelledby="c-faq">
      <h2 id="c-faq" class="font-serif text-3xl font-bold text-cream md:text-4xl">Questions</h2>
      <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
        {
          faq.map(({ q, a }) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-white [&::-webkit-details-marker]:hidden">
                {q}
                <span
                  aria-hidden="true"
                  class="text-2xl leading-none text-cream transition group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 text-white/70">{a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="c-download" class="border-t border-white/10 bg-plum-900" aria-labelledby="c-get">
      <div class="mx-auto flex max-w-3xl flex-col items-center px-5 py-20 text-center md:px-8">
        <h2 id="c-get" class="font-serif text-3xl font-bold text-white md:text-4xl">Get ephira</h2>
        <p class="mt-3 text-white/70">On the App Store and Google Play.</p>
        <StoreBadges class="mt-8 justify-center" />
      </div>
    </section>
  </main>

  <ProtoFooter />
</div>
